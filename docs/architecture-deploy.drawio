<mxfile host="app.diagrams.net" agent="ArchiStyler" version="22.1.0">
  <diagram name="CI Deploy" id="ci-deploy">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="trigger" value="Триггер&#xa;push main / master&#xa;workflow_dispatch" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wf" value=".github/workflows/deploy.yml" style="shape=process;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="240" y="190" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="jobbuild" value="job: build (ubuntu-latest)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="720" height="200" as="geometry" />
        </mxCell>
        <mxCell id="checkout" value="actions/checkout@v4" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="jobbuild">
          <mxGeometry x="20" y="50" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="node" value="setup-node 22&#xa;npm ci" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="jobbuild">
          <mxGeometry x="190" y="50" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="viteenv" value="env: VITE_BASE_PATH&#xa;/&lt;repo-name&gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="jobbuild">
          <mxGeometry x="340" y="50" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="buildcmd" value="npm run build&#xa;tsc --noEmit + vite build" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="jobbuild">
          <mxGeometry x="520" y="50" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="artifact" value="upload-pages-artifact&#xa;path: dist/" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="jobbuild">
          <mxGeometry x="720" y="45" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="jobdeploy" value="job: deploy" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="480" y="280" width="720" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pages" value="actions/deploy-pages@v4&#xa;environment: github-pages&#xa;permissions: pages + id-token" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="jobdeploy">
          <mxGeometry x="200" y="45" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cdn" value="GitHub Pages CDN" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="1240" y="160" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dist" value="dist/&#xa;index.html + assets&#xa;base: vite.config.ts" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="300" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fallback" value="public/404.html&#xa;SPA redirect (deep links)" style="shape=note;whiteSpace=wrap;html=1;size=14;" vertex="1" parent="1">
          <mxGeometry x="1240" y="400" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="vitecfg" value="vite.config.ts&#xa;base = VITE_BASE_PATH ?? '/'" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c1" style="endArrow=classic;html=1;" edge="1" parent="1" source="trigger" target="wf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" style="endArrow=classic;html=1;" edge="1" parent="1" source="wf" target="checkout"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" style="endArrow=classic;html=1;" edge="1" parent="1" source="checkout" target="node"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" style="endArrow=classic;html=1;" edge="1" parent="1" source="node" target="viteenv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" style="endArrow=classic;html=1;" edge="1" parent="1" source="viteenv" target="buildcmd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c6" style="endArrow=classic;html=1;" edge="1" parent="1" source="buildcmd" target="artifact"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c7" value="needs: build" style="endArrow=classic;html=1;" edge="1" parent="1" source="artifact" target="pages">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" style="endArrow=classic;html=1;" edge="1" parent="1" source="pages" target="cdn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c9" style="endArrow=classic;html=1;" edge="1" parent="1" source="cdn" target="dist"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c10" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1" source="dist" target="fallback"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c11" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1" source="vitecfg" target="viteenv"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
